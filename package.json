{
  "name": "getbili",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilibili info API service (Vercel Edge / Cloudflare Workers compatible) for video info, play URLs, danmaku and more",
  "scripts": {
    "dev": "tsx scripts/dev-node.ts",
    "build:node": "esbuild scripts/server.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/server.mjs",
    "docker:build": "docker build -t getbili:latest .",
    "docker:run": "docker run -d --name getbili -p 8787:8787 --env-file .dev.vars -e COOKIE_SECURE=false getbili:latest",
    "deploy": "npx -y vercel --prod",
    "deploy:cf": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/md5-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "debug:upstream": "esbuild scripts/debug-upstream.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/debug-upstream.mjs && node .tmp/debug-upstream.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.4",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.140.0"
  }
}
